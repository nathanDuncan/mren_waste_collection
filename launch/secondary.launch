<launch>
    <!-- Secondary Computer (Robot) Launch -->
    
    <!-- 1. Receiver Node (Receives data from Host) -->
    <node pkg="mren_waste_collector" type="receiver.py" name="receiver_node" output="screen">
        <param name="port" value="25000"/>
        <param name="center_x" value="320.0"/>
        <param name="center_y" value="240.0"/>
    </node>

    <!-- 2. Simple Servoing Node -->
    <node pkg="mren_waste_collector" type="simple_servoing_node" name="simple_servoing_node" output="screen"/>

    <!-- 3. Robot Interface (Optional/Required for HighCmd) -->
    <!-- Launching unitree_legged_real to handle loose communication with robot -->
    <include file="$(find unitree_legged_real)/launch/real.launch">
        <arg name="ctrl_level" value="highlevel"/>
    </include>
</launch>
