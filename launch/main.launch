<launch>
    <arg name="debug" default="false"/>

    <!-- Receiver Node (Receives data from Host running vision) -->
    <node pkg="mren_waste_collector" type="receiver.py" name="receiver_node" output="screen">
        <param name="port" value="25006"/>
        <param name="center_x" value="320.0"/>
        <param name="center_y" value="240.0"/>
    </node>

    <!-- Launch unitree_legged_real -->
    <include file="$(find unitree_legged_real)/launch/real.launch" unless="$(arg debug)">
        <arg name="ctrl_level" value="highlevel"/>
    </include>

    <!-- Launch mren_waste_collector nodes -->
    <!-- <node pkg="mren_waste_collector" type="simple_servoing_node" name="simple_servoing_node" output="screen"/> -->

    <!-- Launch open_manipulator_controller -->
    <include file="$(find open_manipulator_controller)/launch/open_manipulator_controller.launch"/>

    <!-- Waste Collector State Machine -->
    <node pkg="mren_waste_collector" type="pi4_state_machine.py" name="state_machine" output="screen">
        <param name="debug_mode" value="$(arg debug)"/>
    </node>
</launch>

<!--[WARN] [1718657409.303241]: Could not process inbound connection: topic types do not match: [std_msgs/String] vs. [std_msgs/Float32MultiArray]{'callerid': '/state_machine', 'md5sum': '992ce8a1687cec8c8bd883ec73ca41d1', 'message_definition': 'string data\n', 'tcp_nodelay': '0', 'topic': '/camera_data', 'type': 'std_msgs/String'}-->